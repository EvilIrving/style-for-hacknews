{
  "manifest_version": 3,
  "name": "Style for Hacker News",
  "version": "1.0.0",
  "description": "Improve readability and visual comfort of Hacker News with better typography, spacing, and layout.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://news.ycombinator.com/*"],
      "css": ["content.css", "control-panel.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/*.woff2","fonts/*.ttf"],
      "matches": ["https://news.ycombinator.com/*"]
    }
  ]
}
